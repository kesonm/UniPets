<view class="tab-bar" aria-label="底部导航">
  <button
    wx:for="{{tabs}}"
    wx:key="page"
    class="tab-link {{item.page === activePage ? 'selected' : ''}}"
    aria-label="{{item.label}}"
    aria-pressed="{{item.page === activePage}}"
    data-page="{{item.page}}"
    bindtap="navigate"
  >
    <view class="tab-icon {{item.icon === 'identity' ? 'identity' : ''}}">
      <image src="/static/icons/nav-{{item.icon}}{{item.page === activePage ? '-selected' : ''}}.png" mode="aspectFit" />
      <text wx:if="{{item.icon === 'cart' && cartCount}}" class="tab-badge">{{cartCount > 99 ? '99+' : cartCount}}</text>
    </view>
    <text>{{item.label}}</text>
  </button>
</view>

# Copy to .env.local for development, or to server/.env for independent deployment.
# Never prefix server secrets with VITE_.
PORT=3008
HOST=127.0.0.1
NODE_ENV=development
FRONTEND_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
# Enable only when deployed directly over HTTP.
# PETCLOUD_ALLOW_HTTP_AUTH=1
API_PROXY_TARGET=http://127.0.0.1:3008
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=petcloud
DB_USER=petcloud
DB_PASSWORD=replace_with_a_strong_database_password
# Existing account UUID whose pet profiles and cover thumbnails appear as shared H5 profiles.
# H5_DEMO_OWNER_ID=
# Pet UUID under that account whose generated key actions are available for H5 preview.
# H5_DEMO_MOTION_PET_ID=
# Comma-separated existing user UUIDs permitted to publish H5 listings and process bookings and orders.
# H5_OPERATOR_USER_IDS=
# Only needed for the Docker MySQL option:
MYSQL_ROOT_PASSWORD=replace_with_a_different_strong_root_password
# Images and original videos are stored outside the public web directory.
# STORAGE_DIR=/absolute/path/to/petcloud-storage
# Local ONNX pet-nose models. See docs/pet-identity.md for the model input/output contract.
# PET_NOSEPRINT_MODEL_DIR=/absolute/path/to/noseprint-models
# PET_NOSEPRINT_PYTHON=/absolute/path/to/venv/bin/python
# Archived AI generation settings. The web API and worker are disconnected.
# UNIWORK_KEY=
# Video generation uses UNIWORK_KEY unless a separate key is supplied.
# UNIWORK_VIDEO_KEY=
# UNIWORK_VIDEO_MODEL=wan3.0-video
# UNIWORK_VIDEO_BASE_URL=https://pay.uniwork.top/v1
# FFmpeg and FFprobe paths for offline video processing.
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
# Optional: disable local foreground removal (requires macOS 14+ and Command Line Tools).
# PETCLOUD_VIDEO_MATTING=off
# Legacy image-generation compatibility:
# UNIWORK_MODEL=gpt-image-2.5-flare
# UNIWORK_IMAGE_URL=https://pay.uniwork.top/v1/images/edits
# Optional for web/API deployment on different origins. Prefer an /api reverse proxy.
# VITE_API_BASE_URL=https://api.example.com
# Electron accepts HTTPS for remote API servers; localhost may use HTTP.
# PETCLOUD_API_URL=http://127.0.0.1:3008
# PETCLOUD_WEB_URL=http://127.0.0.1:4173
WECHAT_APP_ID=wx0baf7b9e0883ba2f
WECHAT_APP_SECRET=
# Tencent Maps browser Key for the store overview in the administrator dashboard.
# TENCENT_MAP_BROWSER_KEY=
